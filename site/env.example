# Tazza Produce — environment template
# Copy to .env and fill with REAL keys. NEVER commit .env.
# NOTE: Live US Stripe keys require a US Stripe account (US entity + EIN + US bank).
# The Egyptian developer CANNOT open a US account; the site owner must create it.
# Test keys work from any Stripe account and are safe to use for the build/demo.

STRIPE_TEST_PK=pk_test_xxx
STRIPE_TEST_SK=sk_test_xxx
STRIPE_LIVE_PK=pk_live_xxx   # owner-supplied (US account)
STRIPE_LIVE_SK=sk_live_xxx   # owner-supplied (US account)

# Public site URL (used for Stripe Apple Pay domain verification + OG tags)
NEXT_PUBLIC_SITE_URL=https://www.tazzaproduce.com

# Business contact (replace before launch — currently a non-deliverable .example placeholder)
CONTACT_EMAIL=hello@tazzaproduce.example
