# Tazza Produce — environment template
# Copy to .env.local and fill with REAL keys. NEVER commit .env or .env.local.
# NOTE: Live US Stripe keys require a US Stripe account (US entity + EIN + US bank).
# The Egyptian developer CANNOT open a US account; the site owner must create it.
# Test keys work from any Stripe account and are safe to use for the build/demo.
#
# This file (env.example) is committed on purpose; it is NOT a .env file.

STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Public site URL (used for Stripe Apple Pay domain verification + OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
